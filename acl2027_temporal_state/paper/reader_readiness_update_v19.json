{
  "schema_version": "reader_readiness_manuscript_v19",
  "title": "From Source Occurrences to an Executable Reader",
  "subtitle": "WikiGraphRAG v19: research readiness and retained failures",
  "date": "4 October 2026",
  "status": "completed_preparation_checkpoint",
  "claims_scope": {
    "novelty": false,
