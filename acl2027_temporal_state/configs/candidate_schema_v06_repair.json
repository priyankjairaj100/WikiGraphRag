{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "candidate_graph_v0.6"
    },
    "mentions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mention"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "aliases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/alias"
      },
      "minItems": 0,
      "maxItems": 32
    },
    "authorities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/authority"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "essential_support": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      },
      "minItems": 0,
      "maxItems": 128
    },
    "unsupported": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unsupported"
      },
      "minItems": 0,
      "maxItems": 64
    }
  },
  "required": [
    "schema_version",
    "mentions",
    "links",
    "aliases",
    "authorities",
    "essential_support",
    "unsupported"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "bounds": {
      "type": "object",
      "properties": {
        "lower": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        "upper": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        "precision": {
          "enum": [
            "exact_day",
            "bounded_days",
            "year_only",
            "month_only",
            "unknown"
          ]
        }
      },
      "required": [
        "lower",
        "upper",
        "precision"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id",
        "quote"
      ],
      "additionalProperties": false
    },
    "alias": {
      "type": "object",
      "properties": {
        "alias_id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_name": {
          "type": "string",
          "minLength": 1
        },
        "alias": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "derivation_note": {
          "type": "string"
        }
      },
      "required": [
        "alias_id",
        "canonical_name",
        "alias",
        "evidence",
        "derivation_note"
      ],
      "additionalProperties": false
    },
    "reading": {
      "type": "object",
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string"
        },
        "role_qualifier": {
          "type": "string"
        },
        "polarity": {
          "enum": [
            "positive",
            "negative"
          ]
        },
        "modality": {
          "enum": [
            "reported_actual",
            "announced_future",
            "conditional",
            "uncertain"
          ]
        },
        "reported_at": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        "start": {
          "$ref": "#/$defs/bounds"
        },
        "end": {
          "$ref": "#/$defs/bounds"
        },
        "state_observed_at": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "date"
          },
          "minItems": 0,
          "maxItems": 16
        },
        "observation_kind": {
          "enum": [
            "effective_boundary",
            "state_observation",
            "mixed",
            "report_only"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "derivation_note": {
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "subject",
        "relation",
        "value",
        "scope",
        "role_qualifier",
        "polarity",
        "modality",
        "reported_at",
        "start",
        "end",
        "state_observed_at",
        "observation_kind",
        "evidence",
        "derivation_note"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "modality": {
                "const": "announced_future"
              }
            },
            "required": [
              "modality"
            ]
          },
          "then": {
            "properties": {
              "state_observed_at": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "mention": {
      "type": "object",
      "properties": {
        "mention_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "anchor_quote": {
          "type": "string",
          "minLength": 1
        },
        "readings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reading"
          },
          "minItems": 0,
          "maxItems": 4
        },
        "unresolved_reason": {
          "type": "string"
        }
      },
      "required": [
        "mention_id",
        "source_id",
        "anchor_quote",
        "readings",
        "unresolved_reason"
      ],
      "additionalProperties": false
    },
    "correction": {
      "type": "object",
      "properties": {
        "action": {
          "const": "replace"
        },
        "coverage": {
          "const": "whole_assertion"
        },
        "reference_evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "required": [
        "action",
        "coverage",
        "reference_evidence"
      ],
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "properties": {
        "link_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "target_candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "enum": [
            "RESTATES",
            "CHANGES",
            "CORRECTS"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "correction": {
          "anyOf": [
            {
              "$ref": "#/$defs/correction"
            },
            {
              "type": "null"
            }
          ]
        },
        "derivation_note": {
          "type": "string"
        }
      },
      "required": [
        "link_id",
        "candidate_id",
        "target_candidate_id",
        "relation",
        "evidence",
        "correction",
        "derivation_note"
      ],
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "authority_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 8
        }
      },
      "required": [
        "source_id",
        "authority_id",
        "evidence"
      ],
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "properties": {
        "dependent_candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "prerequisite_candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "derivation_note": {
          "type": "string"
        }
      },
      "required": [
        "dependent_candidate_id",
        "prerequisite_candidate_id",
        "evidence",
        "derivation_note"
      ],
      "additionalProperties": false
    },
    "unsupported": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 8
        }
      },
      "required": [
        "source_id",
        "reason",
        "evidence"
      ],
      "additionalProperties": false
    }
  }
}
